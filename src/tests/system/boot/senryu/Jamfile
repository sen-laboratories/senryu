SubDir HAIKU_TOP src tests system boot senryu ;

# Access headers needed for the bootloader/kernel environment
UsePrivateHeaders [ FDirName system boot ] ;
UsePrivateKernelHeaders ;

local jam_file = [ FDirName $(TOP) Jamfile ] ;
local SCRIPTS_DIR = [ FDirName $(HAIKU_TOP) build scripts ] ;
local SANITIZE_PY = [ FDirName $(SCRIPTS_DIR) generate_senryu_boot_splash.py ] ;
local GEN_DIR		  = [ FDirName $(HAIKU_TOP) generated build boot_splash ] ;
local ARTWORK_DIR = [ FDirName $(HAIKU_TOP) data artwork boot_splash ] ;

# The Master Header target
local MASTER_HEADER = [ FGristFiles NeonAssets.h ] ;
MakeLocate $(MASTER_HEADER) : $(GEN_DIR) ;

local GENERATED_HEADERS ;

rule GenerateNeonHeaders
{
    local stages = 0 1 2 3 4 5 6 7 ;
    local states = cold warm vibrant overdrive ;
    local GENERATED_HEADERS ;

    for s in $(stages)
    {
        # 1. Define the source PNG for THIS stage
        local raw = [ FDirName $(ARTWORK_DIR) senryu_boot-splash_$(s).png ] ;
        local current_headers ;

        # 2. Add the staged headers for THIS specific stage index
        for state in $(states) {
            current_headers += stage_$(s)_$(state).h ;
        }

        # 3. Add the static headers ONLY for the first stage (index 0)
        # These are cut from the first splash image.
        if $(s) = 0 {
            # initial fullscreen splash image
            current_headers += stage_0.h ;

            for state in $(states) {
                current_headers += sen_$(state).h ryu_$(state).h ;
            }
        }

        # 4. Convert to targets and locate
        local target_headers = [ FGristFiles $(current_headers) ] ;
        MakeLocate $(target_headers) : $(GEN_DIR) ;

        # BINDINGS: Pass specific variables to the action for this target set
        SANITIZE_PY on $(target_headers) = $(SANITIZE_PY) ;
        GEN_DIR on $(target_headers) = $(GEN_DIR) ;
        # Use :BS to give the shell clean names (e.g. stage_0_cold.h)
        HEADER_NAMES on $(target_headers) = $(target_headers:BS) ;
        STAGE_INDEX on $(target_headers) = $(s) ;

        # Dependencies
        Depends $(target_headers) : $(raw) $(SANITIZE_PY) $(jam_file) ;

        # Execute the cutter for THIS specific PNG
        RunNeonCutter $(target_headers) : $(raw) ;

        GENERATED_HEADERS += $(target_headers) ;
    }

    # 5. Master Merge Setup (outside the loop)
    GENERATED_HEADER_NAMES on $(MASTER_HEADER) = $(GENERATED_HEADERS:BS) ;
    MASTER_HEADER_PATH on $(MASTER_HEADER) = $(MASTER_HEADER:G=) ;
    GEN_DIR on $(MASTER_HEADER) = $(GEN_DIR) ;

    Depends $(MASTER_HEADER) : $(GENERATED_HEADERS) ;
    MergeNeonHeaders $(MASTER_HEADER) ;

    Includes [ FGristFiles NeonDaemon.cpp ] : $(MASTER_HEADER) ;
}

actions RunNeonCutter
{
    python3 "$(SANITIZE_PY)" "$(>)" "$(STAGE_INDEX)" "$(GEN_DIR)"

    cd "$(GEN_DIR)"
    for h_file in $(HEADER_NAMES) ; do
        # Strip .h to get the base name
        base="${h_file%.h}"

        # If the file exists as a .png, convert it
        if [ -f "${base}.raw" ]; then
            (tinyxxd -i -n "${base}" "${base}.raw" > "$h_file")
        else
            # DEBUG: This will show up in your Jam output if a file is missing
            printf "Warning: Expected ${base}.raw but it was not created by the script.\n"
        fi
    done
}

# executed by sh
actions MergeNeonHeaders
{
    printf "// Auto-generated SENryu Neon Assets\n" > "$(MASTER_HEADER_PATH)"
    printf "#pragma once" >> "$(MASTER_HEADER_PATH)"

 	cd "$(GEN_DIR)"
    # remove stale output if exists
    rm -f "$(MASTER_HEADER_PATH)"

    for header in $(GENERATED_HEADER_NAMES:BS) ; do
        printf "> merging header ${header}...\n"
        cat "${header}" >> "$(MASTER_HEADER_PATH)"
        printf "\n" >> "$(MASTER_HEADER_PATH)"
    done
}

# 1. Process all artwork stages
local raw_files = [ Glob $(ARTWORK_DIR) : senryu_boot-splash_*.png ] ;
GenerateNeonHeaders $(raw_files) ;

# 2. Define the Test Application
SimpleTest NeonDaemon :
    NeonDaemon.cpp
    : be stdc++
;
