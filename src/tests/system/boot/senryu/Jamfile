SubDir HAIKU_TOP src tests system boot senryu ;

# Access headers needed for the bootloader/kernel environment
UsePrivateHeaders [ FDirName system boot ] ;
UsePrivateKernelHeaders ;

local SCRIPTS_DIR = [ FDirName $(HAIKU_TOP) build scripts ] ;
local SANITIZE_PY = [ FDirName $(SCRIPTS_DIR) generate_senryu_boot_splash.py ] ;
local GEN_DIR = [ FDirName $(HAIKU_TOP) generated build boot_splash ] ;
local ARTWORK_DIR = [ FDirName $(HAIKU_TOP) data artwork boot_splash ] ;

# The Master Header target
local MASTER_HEADER = [ FGristFiles NeonAssets.h ] ;
MakeLocate $(MASTER_HEADER) : $(GEN_DIR) ;

rule GenerateNeonHeaders sources
{
    local all_headers ;
    for raw in $(sources) {
# Match EXACTLY one or more digits after the last underscore
        local name = [ MATCH ".*_([0-9]+)\\.png" : $(raw) ] ;

        # Ensure 'name' is just a single digit for the stage circuits
        # If the circuit is 'sen' or 'ryu', we don't use 'name' at all!

        local circuit = [ MATCH "(.*)_[0-9]+\\.png" : $(raw) ] ;
        local h_files ;

        if $(circuit) = "stage" {
            h_files = stage_$(name)_cold.h stage_$(name)_warm.h stage_$(name)_vibrant.h stage_$(name)_overdrive.h ;
        } else {
            # Static circuits (sen, ryu) - No $(name) index in the header filename!
            h_files = $(circuit)_cold.h $(circuit)_warm.h $(circuit)_vibrant.h $(circuit)_overdrive.h ;
        }

        local target_headers = [ FGristFiles $(h_files) ] ;

        MakeLocate $(target_headers) : $(GEN_DIR) ;
        Depends $(target_headers) : $(raw) $(SANITIZE_PY) ;
        
        SANITIZE_PY on $(target_headers) = $(SANITIZE_PY) ;
        GEN_DIR on $(target_headers) = $(GEN_DIR) ;
        
        RunNeonCutter $(target_headers) : $(raw) ;
        all_headers += $(target_headers) ;
    }

    # Create the single master header
    Depends $(MASTER_HEADER) : $(all_headers) ;
    MergeNeonHeaders $(MASTER_HEADER) : $(all_headers) ;

    # Ensure the source file waits for the master header
    Includes [ FGristFiles NeonDaemon.cpp ] : $(MASTER_HEADER) ;
}

actions RunNeonCutter
{
    python3 "$(SANITIZE_PY)" "$(>)" "$(GEN_DIR)"
    # Clean up variable names in headers using tinyxxd
    (cd "$(GEN_DIR)" && for f in *.png; do tinyxxd -i "$f" > "${f%.png}.h"; done)
}

# executed by sh
actions MergeNeonHeaders
{
    echo "// Auto-generated SENryu Neon Assets" > "$(1)"
    echo "#pragma once" >> "$(1)"
    for header in $(>) ; do
        echo "> merging header ${header}"
        cat "${header}" >> "$(1)"
        echo "" >> "$(1)"
    done
}

# 1. Process all artwork stages
local raw_files = [ Glob $(ARTWORK_DIR) : senryu_boot-splash_*.png ] ;
GenerateNeonHeaders $(raw_files) ;

# 2. Define the Test Application
SimpleTest NeonDaemon :
    NeonDaemon.cpp
    : be
;
