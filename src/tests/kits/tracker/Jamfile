SubDir HAIKU_TOP src tests kits tracker ;

AddSubDirSupportedPlatforms libbe_test ;

UsePrivateHeaders storage tracker ;

# SEN headers, see src/kits/tracker/Jamfile for the same setup.
SubDirC++Flags -I/boot/home/config/non-packaged/develop/headers ;

# Pull in the stateless SEN utility sources directly rather than linking
# libtracker.so - these tests exercise pure attribute/filesystem logic and
# shouldn't need the rest of Tracker's GUI/app machinery to run.
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src kits tracker ] ;

UnitTestLib libtrackerkittest.so
	: TrackerKitTestAddon.cpp
		TrackerSenRelationsTest.cpp
		TemplateUtilsTest.cpp
		TrackerSenRelations.cpp
		TemplateUtils.cpp
	: be [ TargetLibstdc++ ]
;
